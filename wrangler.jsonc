{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "field-kit",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "field-kit",
      "migrations_dir": "migrations"
    }
  ]
}
